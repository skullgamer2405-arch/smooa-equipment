{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "stitch_frontend/**"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/equipment",
        "destination": "/index.html"
      },
      {
        "source": "/equipment.html",
        "destination": "/index.html"
      },
      {
        "source": "/calendar",
        "destination": "/index.html"
      },
      {
        "source": "/calendar.html",
        "destination": "/index.html"
      },
      {
        "source": "/booking",
        "destination": "/index.html"
      },
      {
        "source": "/booking.html",
        "destination": "/index.html"
      },
      {
        "source": "/admin",
        "destination": "/index.html"
      },
      {
        "source": "/admin.html",
        "destination": "/index.html"
      },
      {
        "source": "/success",
        "destination": "/index.html"
      },
      {
        "source": "/success.html",
        "destination": "/index.html"
      },
      {
        "source": "/my-bookings",
        "destination": "/index.html"
      },
      {
        "source": "/my-bookings.html",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 4400
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4500
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
