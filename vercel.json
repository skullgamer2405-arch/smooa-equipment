{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "if [ \"$VERCEL_ENV\" = \"preview\" ]; then VITE_DEMO_MODE=true npm run build -- --mode demo; else npm run build; fi",
      "devCommand": "npm run dev:web -- --host 127.0.0.1",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/:page(equipment|calendar|booking|success|admin)",
          "destination": "/index.html"
        },
        {
          "source": "/:page(equipment|calendar|booking|success|admin).html",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": ".",
      "framework": "express",
      "runtime": "nodejs24.x",
      "entrypoint": "server.js",
      "installCommand": "npm ci",
      "buildCommand": "node --check server.js",
      "functions": {
        "server.js": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/uploads/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/line/reminders",
      "schedule": "0 2 * * *"
    }
  ]
}
