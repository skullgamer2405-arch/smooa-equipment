rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Helper functions
    // ============================================

    // ตรวจว่า user เป็น authenticated admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true
        && request.auth.token.email_verified == true;
    }

    // ตรวจ string field ว่ามีค่าและไม่เกิน maxLen
    function validStr(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }

    // ============================================
    // Equipment Collection
    // - Read: anyone (public catalog)
    // - Write: authenticated admin only
    // ============================================
    match /equipment/{equipmentId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['title', 'assetCode', 'status', 'createdAt'])
        && validStr(request.resource.data.title, 200)
        && validStr(request.resource.data.assetCode, 50)
        && request.resource.data.status in ['available', 'unavailable', 'maintenance'];
      allow update, delete: if isAdmin();
    }

    // ============================================
    // Bookings Collection
    // - Read: verified admin only
    // - All writes: validated server API only
    // ============================================
    match /bookings/{bookingId} {
      allow read: if isAdmin();
      // Creation, decisions and returns pass server validation and transactions.
      allow write: if false;
    }

    // ============================================
    // Calendar Entries Collection (admin-managed)
    // - Read: anyone
    // - Write: authenticated admin only
    // ============================================
    match /calendarEntries/{entryId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['date', 'activityName', 'createdAt'])
        && validStr(request.resource.data.activityName, 300);
      allow update, delete: if isAdmin();
    }

    // LINE recipients/tokens/delivery state are never exposed to browser clients.
    // Only the server Admin SDK may access these collections.
    match /lineBookingRecipients/{document=**} {
      allow read, write: if false;
    }
    match /lineNotifications/{document=**} {
      allow read, write: if false;
    }

    // Public calendar is a server-managed projection; it never contains borrower fields.
    match /publicCalendar/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
