    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "firebase": "^11.7.3",
    "firebase-admin": "^14.3.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "nodemailer": "^7.0.13",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
