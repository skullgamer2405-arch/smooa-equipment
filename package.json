{
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch server.js",
    "dev:demo": "vite --host 0.0.0.0 --mode demo",
    "dev:convex": "convex dev",
    "dev:vercel": "npx vercel@65.2.0 dev",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:server": "node --test tests/server.test.mjs",
    "start": "node server.js",
    "preview": "vite preview --host 0.0.0.0",
    "omniroute:check": "node scripts/omniroute-check.mjs"
  },
