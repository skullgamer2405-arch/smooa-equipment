# Environment Configuration
# Firebase is configured in /public/js/firebase-config.js

# Admin Email Notification Settings (Optional - if using SMTP/Gmail for sending real emails)
ADMIN_NOTIFICATION_EMAIL=skullgamer2405@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional canonical public origin for email links. Vercel otherwise uses VERCEL_URL.
# This is a public application URL, not a service binding.
PUBLIC_APP_URL=

# Blocks real APIs/uploads; Vercel Preview enforces this automatically.
SMO_DEMO_MODE=false

# LINE: disabled until both channels, credentials and Firebase are configured.
# Never put the Messaging API token, service account or CRON_SECRET in VITE_* variables.
LINE_ENABLED=false
VITE_LINE_LIFF_ID=
VITE_LINE_OA_URL=
# LINE Login channel ID (same provider as the OA Messaging API channel).
LINE_LOGIN_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Verified Firebase admin emails, comma-separated. New LINE approval endpoints fail closed.
LINE_ADMIN_EMAILS=
# Random secret >=32 characters; Vercel Cron supplies it as Authorization: Bearer.
CRON_SECRET=
# Server Firebase Admin credentials, configured only in the deployment secret store.
FIREBASE_SERVICE_ACCOUNT_JSON=
