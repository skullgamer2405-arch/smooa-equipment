# Environment Configuration
# Firebase Console -> Project settings -> Your apps -> Web app SDK config.
# Public web selectors, separate per environment (test project vs production).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Email setup guide: docs/admin-email-setup.md (server-only; never use VITE_*).
# One recipient for new booking requests. Separate from the sender and admin login.
ADMIN_NOTIFICATION_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional sender address; defaults to SMTP_USER. Use an address permitted by the provider.
SMTP_FROM=

# Optional canonical HTTPS public origin for admin email links (no inferred preview URL).
# This is a public application URL, not a service binding.
PUBLIC_APP_URL=

# Blocks real APIs/uploads; Vercel Preview enforces this automatically.
SMO_DEMO_MODE=false

# LINE: disabled until both channels, credentials and Firebase are configured.
# Never put the Messaging API token, service account or CRON_SECRET in VITE_* variables.
LINE_ENABLED=false
VITE_LINE_LIFF_ID=
VITE_LINE_OA_URL=https://line.me/R/ti/p/@474ezowf
# LINE Login channel ID (same provider as the OA Messaging API channel).
LINE_LOGIN_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Admin access uses verified Firebase identity + server-issued admin=true custom claim.
# Use scripts/admin-claim.mjs with an owner-verified UID; no browser flag grants access.
# Random secret >=32 characters; Vercel Cron supplies it as Authorization: Bearer.
CRON_SECRET=
# Server Firebase Admin credentials, configured only in the deployment secret store.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Persistent Firebase Storage bucket for validated equipment images (public bucket name).
FIREBASE_STORAGE_BUCKET=
# Explicitly opt in to ADC only on a trusted managed environment.
FIREBASE_USE_ADC=false
# Shared secret >=32 chars, paired with SMO_WEBHOOK_SECRET in Apps Script Properties.
APPS_SCRIPT_SHARED_SECRET=
# Optional alternative to SMTP; empty DB setting overrides this default intentionally.
APPS_SCRIPT_WEBHOOK_URL=
